{
  "name": "eleja",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "api": "npm run start --workspace @eleja/api",
    "batch": "npm run start --workspace @eleja/batch",
    "batch:candidates": "npm run start:candidates --workspace @eleja/batch --",
    "batch:candidates:parse": "npm run start:candidates:parse --workspace @eleja/batch --",
    "batch:candidates:normalize": "npm run start:candidates:normalize --workspace @eleja/batch --",
    "batch:candidates:persist": "npm run start:candidates:persist --workspace @eleja/batch --",
    "batch:candidates:history": "npm run start:candidates:history --workspace @eleja/batch --",
    "batch:assets": "npm run start:assets --workspace @eleja/batch --",
    "batch:assets:persist": "npm run start:assets:persist --workspace @eleja/batch --",
    "batch:export": "npm run start:export --workspace @eleja/batch --",
    "batch:publish": "npm run start:publish --workspace @eleja/batch --",
    "batch:run": "npm run start:run --workspace @eleja/batch --",
    "r2:check": "npm run r2:check --workspace @eleja/batch",
    "batch:camara:match-deputies": "npm run start:camara:match-deputies --workspace @eleja/batch --",
    "batch:camara:mandates": "npm run start:camara:mandates --workspace @eleja/batch --",
    "batch:camara:proposals": "npm run start:camara:proposals --workspace @eleja/batch --",
    "batch:camara:votes": "npm run start:camara:votes --workspace @eleja/batch --",
    "batch:camara:expenses": "npm run start:camara:expenses --workspace @eleja/batch --",
    "web": "npm run start --workspace @eleja/web",
    "build": "npm run build --workspace @eleja/database && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @eleja/database && npm run test:integration --workspace @eleja/batch && npm run test:integration --workspace @eleja/api",
    "lint": "eslint .",
    "typecheck": "npm run build --workspace @eleja/database && npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "migration:create": "npm run migration:create --workspace @eleja/database",
    "migration:up": "npm run migration:up --workspace @eleja/database",
    "migration:down": "npm run migration:down --workspace @eleja/database",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.0",
    "typescript-eslint": "^8.48.0"
  }
}
